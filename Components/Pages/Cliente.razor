@page "/cliente"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<PageTitle>Clientes</PageTitle>

<h3 class="mb-3">Administración de clientes</h3>

@* ===== Mensajes de resultado ===== *@
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="NuevoCliente">Nuevo</button>
</div>

@* ===== Tabla de clientes (sin mostrar id_cliente) ===== *@
@if (cargando)
{
    <div class="text-center my-4">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Cargando clientes...</p>
    </div>
}
else if (clientes.Count == 0)
{
    <div class="alert alert-info">No hay clientes registrados. Usa el botón Nuevo para agregar el primero.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>CUI</th>
                    <th>NIT</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Fecha de nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in ClientesPagina)
                {
                    <tr>
                        <td>@c.Cui</td>
                        <td>@c.Nit</td>
                        <td>@c.Nombres</td>
                        <td>@c.Apellidos</td>
                        <td>@c.Direccion</td>
                        <td>@c.Telefono</td>
                        <td>@c.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditarCliente(c)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => PedirConfirmacionEliminar(c)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ===== Paginación ===== *@
    <nav aria-label="Paginación de clientes">
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">Anterior</button>
            </li>
            @for (int i = 1; i <= TotalPaginas; i++)
            {
                var pagina = i;
                <li class="page-item @(pagina == paginaActual ? "active" : "")">
                    <button class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</button>
                </li>
            }
            <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">
                <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
}

@* ===== Modal: formulario de cliente (Nuevo / Editar) ===== *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <EditForm EditContext="editContext" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">@(esEdicion ? "Editar cliente" : "Nuevo cliente")</h5>
                        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarModal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">CUI</label>
                                <InputText class="form-control" @bind-Value="cliente.Cui" maxlength="13" />
                                <ValidationMessage For="() => cliente.Cui" class="invalid-feedback" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">NIT</label>
                                <InputText class="form-control" @bind-Value="cliente.Nit" maxlength="15" />
                                <ValidationMessage For="() => cliente.Nit" class="invalid-feedback" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control" @bind-Value="cliente.Nombres" />
                                <ValidationMessage For="() => cliente.Nombres" class="invalid-feedback" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control" @bind-Value="cliente.Apellidos" />
                                <ValidationMessage For="() => cliente.Apellidos" class="invalid-feedback" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control" @bind-Value="cliente.Direccion" />
                                <ValidationMessage For="() => cliente.Direccion" class="invalid-feedback" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="cliente.Telefono" maxlength="8" />
                                <ValidationMessage For="() => cliente.Telefono" class="invalid-feedback" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate class="form-control" @bind-Value="cliente.FechaNacimiento" />
                                <ValidationMessage For="() => cliente.FechaNacimiento" class="invalid-feedback" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        @if (esEdicion)
                        {
                            <button type="submit" class="btn btn-warning" disabled="@guardando">Actualizar</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success" disabled="@guardando">Guardar</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* ===== Modal: confirmación para eliminar ===== *@
@if (clienteAEliminar is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarEliminar"></button>
                </div>
                <div class="modal-body">
                    ¿Desea eliminar a <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>? Esta acción no se puede deshacer.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEliminar">No</button>
                    <button type="button" class="btn btn-danger" @onclick="EliminarAsync">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    // ===== Ruta del controlador en tu API (ajústala si tu controlador se llama distinto) =====
    private const string Ruta = "api/Clientes";

    // ===== Estado de la página =====
    private List<ClienteModel> clientes = new();
    private ClienteModel cliente = new();
    private ClienteModel? clienteAEliminar;
    private EditContext editContext = default!;

    private bool cargando;
    private bool guardando;
    private bool mostrarModal;
    private bool esEdicion;

    private string? mensajeError;
    private string? mensajeExito;

    // ===== Paginación =====
    private int paginaActual = 1;
    private const int TamanoPagina = 5;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(clientes.Count / (double)TamanoPagina));
    private IEnumerable<ClienteModel> ClientesPagina =>
        clientes.Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        await CargarClientesAsync();
    }

    // ===== GET: leer clientes =====
    private async Task CargarClientesAsync()
    {
        try
        {
            cargando = true;
            clientes = await Http.GetFromJsonAsync<List<ClienteModel>>(Ruta) ?? new();
            if (paginaActual > TotalPaginas) paginaActual = TotalPaginas;
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudieron cargar los clientes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas) paginaActual = pagina;
    }

    // ===== Abrir modal: nuevo =====
    private void NuevoCliente()
    {
        esEdicion = false;
        PrepararFormulario(new ClienteModel());
        mostrarModal = true;
    }

    // ===== Abrir modal: editar (copia los datos de la fila) =====
    private void EditarCliente(ClienteModel c)
    {
        esEdicion = true;
        PrepararFormulario(new ClienteModel
        {
            IdCliente = c.IdCliente,
            Cui = c.Cui,
            Nit = c.Nit,
            Nombres = c.Nombres,
            Apellidos = c.Apellidos,
            Direccion = c.Direccion,
            Telefono = c.Telefono,
            FechaNacimiento = c.FechaNacimiento
        });
        mostrarModal = true;
    }

    private void PrepararFormulario(ClienteModel modelo)
    {
        cliente = modelo;
        editContext = new EditContext(cliente);
        editContext.SetFieldCssClassProvider(new BootstrapFieldCssClassProvider());
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    // ===== POST (crear) o PUT (actualizar) =====
    private async Task GuardarAsync()
    {
        try
        {
            guardando = true;
            HttpResponseMessage respuesta = esEdicion
                ? await Http.PutAsJsonAsync($"{Ruta}/{cliente.IdCliente}", cliente)
                : await Http.PostAsJsonAsync(Ruta, cliente);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeError = null;
                mensajeExito = esEdicion ? "Cliente actualizado correctamente." : "Cliente guardado correctamente.";
                mostrarModal = false;
                await CargarClientesAsync(); // refresca la tabla
            }
            else
            {
                mensajeError = $"El API respondió {(int)respuesta.StatusCode}: {await respuesta.Content.ReadAsStringAsync()}";
                mostrarModal = false;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar el cliente: {ex.Message}";
            mostrarModal = false;
        }
        finally
        {
            guardando = false;
        }
    }

    // ===== DELETE: confirmación + borrado =====
    private void PedirConfirmacionEliminar(ClienteModel c) => clienteAEliminar = c;

    private void CancelarEliminar() => clienteAEliminar = null;

    private async Task EliminarAsync()
    {
        if (clienteAEliminar is null) return;

        try
        {
            var respuesta = await Http.DeleteAsync($"{Ruta}/{clienteAEliminar.IdCliente}");
            if (respuesta.IsSuccessStatusCode)
            {
                mensajeError = null;
                mensajeExito = "Cliente eliminado correctamente.";
                await CargarClientesAsync(); // refresca la tabla
            }
            else
            {
                mensajeError = $"El API respondió {(int)respuesta.StatusCode}: {await respuesta.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo eliminar el cliente: {ex.Message}";
        }
        finally
        {
            clienteAEliminar = null;
        }
    }

    // ===== Modelo con validaciones. [JsonPropertyName] enlaza cada propiedad con el nombre del JSON de tu API =====
    public class ClienteModel
    {
        [JsonPropertyName("id_Cliente")]
        public int IdCliente { get; set; }

        [Required(ErrorMessage = "El CUI es obligatorio.")]
        [RegularExpression(@"^\d{13}$", ErrorMessage = "El CUI debe tener 13 dígitos.")]
        [JsonPropertyName("cui")]
        public string? Cui { get; set; }

        [Required(ErrorMessage = "El NIT es obligatorio.")]
        [StringLength(15, ErrorMessage = "El NIT no puede pasar de 15 caracteres.")]
        [JsonPropertyName("nit")]
        public string? Nit { get; set; }

        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        [JsonPropertyName("nombres")]
        public string? Nombres { get; set; }

        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [StringLength(100, ErrorMessage = "Máximo 100 caracteres.")]
        [JsonPropertyName("apellidos")]
        public string? Apellidos { get; set; }

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(200, ErrorMessage = "Máximo 200 caracteres.")]
        [JsonPropertyName("direccion")]
        public string? Direccion { get; set; }

        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(@"^\d{8}$", ErrorMessage = "El teléfono debe tener 8 dígitos.")]
        [JsonPropertyName("telefono")]
        public string? Telefono { get; set; }

        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        [JsonPropertyName("fecha_nacimiento")]
        public DateTime? FechaNacimiento { get; set; }
    }

    // ===== Hace que Blazor use las clases de validación de Bootstrap (is-valid / is-invalid) =====
    public class BootstrapFieldCssClassProvider : FieldCssClassProvider
    {
        public override string GetFieldCssClass(EditContext editContext, in FieldIdentifier fieldIdentifier)
        {
            var esValido = !editContext.GetValidationMessages(fieldIdentifier).Any();

            if (editContext.IsModified(fieldIdentifier))
                return esValido ? "is-valid" : "is-invalid";

            return esValido ? "" : "is-invalid";
        }
    }
}
